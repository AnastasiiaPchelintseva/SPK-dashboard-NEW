# Пример .env. .env в git НЕ идет. Приложение запускается и с ПУСТЫМ .env: без базы —
# страница «Не настроено», без входа — только то, что настроено (PLATFORM.md, раздел 2).

# --- База PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spk_dashboard
DB_USER=spk_dashboard
DB_PASSWORD=

# --- Вход в веб ---
# Пароль локального пользователя admin. Пусто — вход администратора выключен.
ADMIN_PASSWORD=
# Приложение на oauth.yandex.ru: Redirect URI https://<домен>/signin-yandex,
# доступы «Адрес электронной почты» и «Логин, имя и фамилия». Пусто — вход через Яндекс выключен.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
